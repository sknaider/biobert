# Development Dockerfile for BioBERT
# Includes all development tools, testing frameworks, and Jupyter

FROM python:3.10-slim

LABEL maintainer="DMIS Lab <dmis.korea@gmail.com>"
LABEL description="BioBERT Development Environment"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=0 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies including git for development
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    vim \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash biobert && \
    mkdir -p /app /data /models /output && \
    chown -R biobert:biobert /app /data /models /output

WORKDIR /app

# Copy requirements
COPY requirements.txt requirements-dev.txt /app/

# Install dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install -r requirements-dev.txt && \
    pip install jupyter jupyterlab ipywidgets

# Copy application code
COPY --chown=biobert:biobert . /app/

# Switch to non-root user
USER biobert

# Expose Jupyter port
EXPOSE 8888

# Default command
CMD ["/bin/bash"]
